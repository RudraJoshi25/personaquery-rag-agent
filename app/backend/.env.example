# Copy this file to .env and fill in real values for local development.
# In production (Render), set these as real environment variables in the
# dashboard instead of committing a .env file.

# --- Core ---
# development enables local-friendly defaults (e.g. CORS_ALLOW_ALL is
# tolerated); production is fail-safe/strict by default. Keep this at
# "production" on Render.
ENVIRONMENT=production
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_CONNECT=5
GROQ_TIMEOUT_READ=45
GROQ_MAX_RETRIES=2

# --- Data / retrieval ---
PRIVATE_DATA_DIR=../../data/private
RAG_STORAGE_DIR=storage
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_DIM=384
EMBED_BATCH=16
TOP_K=8
RAG_VECTOR_ENABLED=true
RAG_HYBRID_ENABLED=true
RAG_MIN_SCORE=0
# Ingestion-time cap on number of chunks indexed (scripts/ingest.py), to
# avoid RAM blowups on low-memory hosts. Not read at request-serving time.
MAX_CHUNKS=600

# --- Safety ---
INJECTION_GUARD_ENABLED=true
# Last-line-of-defense regex scrub of emails in the /chat response body,
# independent of ingestion-time redaction (src/rag/ingestion/pii_redact.py).
DEFENSIVE_PII_REDACTION_ENABLED=true
# PII-redaction allowlist: the owner's own already-public contact details.
# Anything else matching these patterns in ingested text gets redacted.
OWNER_EMAIL=rudrajoshi.cs@gmail.com
OWNER_PHONE=+61466988797

# --- CORS ---
# Dev-only escape hatch (allow_origins=["*"]). Must never be true together
# with ENVIRONMENT=production - the app refuses to start if it is.
CORS_ALLOW_ALL=false
# Comma-separated exact origins allowed to call this API from a browser.
# Empty means NO cross-origin browser access is allowed (fails closed) -
# set this to your real frontend's origin(s) before relying on the UI.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
# Optional regex for e.g. Vercel preview deployments. Leave unset unless you
# need it, and scope it to your own project - do not use a bare ".*\.vercel\.app"
# pattern, which would trust any tenant's app on the platform.
CORS_ALLOW_ORIGIN_REGEX=

# --- Rate limiting (per client IP; "limits" library syntax) ---
RATE_LIMIT_CHAT=10/minute;200/day
RATE_LIMIT_INTERVIEW_START=5/minute;50/day
RATE_LIMIT_INTERVIEW_ANSWER=10/minute;200/day

# --- Input validation ---
CHAT_MAX_QUESTION_LENGTH=2000
INTERVIEW_ANSWER_MAX_LENGTH=4000

# --- Interview session hygiene (in-memory sessions; single-process only) ---
INTERVIEW_SESSION_TTL_SECONDS=1800
INTERVIEW_MAX_SESSIONS=500

# --- Logging ---
LOG_LEVEL=INFO
# json for production (log-aggregator friendly); text for readable local dev.
LOG_FORMAT=json
# Logs a short preview of the question text (not the full question/answer)
# to aid debugging retrieval/guardrails without capturing arbitrary free-text
# user input wholesale. Set to false for a stricter privacy posture.
LOG_INCLUDE_QUESTION_PREVIEW=true
LOG_QUESTION_PREVIEW_CHARS=120

# --- Startup ---
# Fail fast on dangerous misconfiguration (e.g. CORS_ALLOW_ALL=true in
# production) instead of starting a broken/insecure instance. Only disable
# in an emergency.
STRICT_STARTUP_CHECKS=true

# --- Health checks ---
# If the embedding model fails to load, /health/ready reports not-ready and
# re-attempts the load at most once per this many seconds. Prevents a probe
# loop from repeatedly retrying an expensive load on an already memory-starved
# process, while still letting readiness recover on its own.
HEALTH_EMBEDDER_RETRY_SECONDS=60

# --- Not read via os.getenv() in this codebase, but relevant at runtime ---
# PORT is injected by Render/Docker and consumed directly by uvicorn's
# --port flag / $PORT shell expansion, not read as a Python env var here.
